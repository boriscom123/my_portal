# Образец конфигурации. Скопировать в .env и заполнить.
# .env в git не попадает — репозиторий публичный.
# Ни одно значение отсюда не должно оказаться в коде: всё читается из окружения.

# --- Адрес портала ------------------------------------------------------------
# Единственное место, где живёт адрес. Из него собираются все ссылки, адреса
# возврата OAuth и манифест PWA. Смена адреса = правка этой строки плюс
# перенастройка кабинетов OAuth. К этому адресу намертво привязаны
# установленные PWA и подписки на пуши: сменить его позже нельзя без
# переустановки приложения у каждого. Второй домен проекта (soloaijourney.ru)
# отвечает редиректом сюда и в коде не участвует.
PUBLIC_BASE_URL=https://soloaijourney.online

# Подключение оверлея этого VPS: снимает публикацию порта и включает контейнер
# в общие сети общего слоя. На чистой машине строка не нужна — там поднимается
# профиль standalone со своей базой.
COMPOSE_FILE=docker-compose.yml:/path/to/ClaudeDocker/projects/my_portal/docker-compose.yml

# --- База данных --------------------------------------------------------------
# На VPS база живёт в общем слое ClaudeDocker и доступна по алиасу `postgres`
# на сети shared-data. На чистой машине под профилем standalone поднимается
# свой контейнер, и тогда здесь `db`.
DB_HOST=postgres
DB_PORT=5432
DB_NAME=portal
DB_USER=portal
DB_PASS=

# --- Очередь ------------------------------------------------------------------
# Общий Redis из слоя ClaudeDocker. Имя контейнера, а НЕ короткий алиас `redis`:
# на этом сервере алиас `redis` носят ДВА разных сервера — общий на сети
# shared-data и ClaudeService на claude-net. Контейнер, подключённый к обеим
# сетям (а api подключён), получает по короткому имени то один, то другой.
# Из-за этого api складывал задачи в чужую Redis, а воркер читал общую, и
# обработка молча не начиналась.
REDIS_URL=redis://shared-redis-1:6379
REDIS_PREFIX=portal:

# --- Криптография -------------------------------------------------------------
# JWT_SECRET подписывает токены сессий.
# TOKEN_ENCRYPTION_KEY шифрует токены доступа к площадкам в базе (32 байта в hex).
JWT_SECRET=
TOKEN_ENCRYPTION_KEY=

# --- Администратор ------------------------------------------------------------
# Кто получает роль admin при входе. Список пар «провайдер:идентификатор» через
# запятую, например: google:1234567890,tg_widget:987654321. Роль не выдаётся по
# факту регистрации: портал публичный, первым зарегистрироваться может кто угодно.
# Пересчитывается при каждом входе, так что правка действует со следующего.
ADMIN_IDENTITIES=

# --- Web Push (VAPID) ---------------------------------------------------------
# Генерируются один раз. Смена ключей обнуляет все существующие подписки.
VAPID_PUBLIC=
VAPID_PRIVATE=
VAPID_SUBJECT=mailto:admin@example.com

# --- Вход: OAuth --------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
VK_CLIENT_ID=
VK_CLIENT_SECRET=
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=

# --- Вход и уведомления: Telegram ---------------------------------------------
# Бот проекта — @solo_ai_journey_bot. Один и тот же токен обслуживает виджет
# входа на сайте, подпись мини-приложения и рассылку уведомлений.
TELEGRAM_BOT_TOKEN=
# Канал t.me/solo_ai_journey, где бот администратор. Туда с этапа 8 уходит
# анонс вышедшего урока.
TELEGRAM_CHANNEL_ID=

# --- Вход и уведомления: MAX --------------------------------------------------
MAX_BOT_TOKEN=

# --- Яндекс Диск: откуда портал берёт исходники -------------------------------
# Приложение в Яндекс OAuth с правом на Диск REST API. Доступ по OAuth, а не по
# публичной ссылке: публичная ссылка делает невышедший урок доступным всякому,
# кто её увидит, а токен — нет.
# Адрес возврата в кабинете приложения:
#   https://<адрес портала>/api/integrations/yandex-disk/callback
YANDEX_OAUTH_CLIENT_ID=
YANDEX_OAUTH_CLIENT_SECRET=

# --- Обработка: расшифровка и генерация текстов -------------------------------
# По умолчанию Яндекс: оплата рублями, хорошее качество на русской речи.
# Поставщик скрыт за тонким слоем, замена — правка одного файла.
YANDEX_CLOUD_API_KEY=
YANDEX_CLOUD_FOLDER_ID=

# --- Публикация на площадки ---------------------------------------------------
# Долгоживущие токены доступа лежат в базе в зашифрованном виде,
# здесь только реквизиты приложений.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
VK_API_APP_ID=
VK_API_SECRET=
RUTUBE_CLIENT_ID=
RUTUBE_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# --- Тесты --------------------------------------------------------------------
# База для прогона тестов. В бою пустая: тесты в продакшене не запускаются,
# а непустое значение здесь означало бы, что боевые данные кто-то вычистит
# командой TRUNCATE из тестового помощника.
TEST_DATABASE_URL=

# --- Рабочий буфер ------------------------------------------------------------
# Каталог временных файлов и срок их жизни в часах.
# Постоянного видеоархива нет: по истечении срока файлы удаляются.
MEDIA_DIR=/app/media
MEDIA_TTL_HOURS=168
