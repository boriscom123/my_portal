# Образец конфигурации. Скопировать в .env и заполнить.
# .env в git не попадает — репозиторий публичный.
# Ни одно значение отсюда не должно оказаться в коде: всё читается из окружения.

# --- Адрес портала ------------------------------------------------------------
# Единственное место, где живёт адрес. Из него собираются все ссылки, адреса
# возврата OAuth и манифест PWA. Смена адреса = правка этой строки плюс
# перенастройка кабинетов OAuth. К этому адресу намертво привязаны
# установленные PWA и подписки на пуши: сменить его позже нельзя без
# переустановки приложения у каждого. Второй домен проекта (soloaijourney.ru)
# отвечает редиректом сюда и в коде не участвует.
PUBLIC_BASE_URL=https://soloaijourney.online

# Подключение оверлея этого VPS: снимает публикацию порта и включает контейнер
# в общие сети общего слоя. На чистой машине строка не нужна — там поднимается
# профиль standalone со своей базой.
COMPOSE_FILE=docker-compose.yml:/path/to/ClaudeDocker/projects/my_portal/docker-compose.yml

# --- База данных --------------------------------------------------------------
# На VPS база живёт в общем слое ClaudeDocker и доступна по алиасу `postgres`
# на сети shared-data. На чистой машине под профилем standalone поднимается
# свой контейнер, и тогда здесь `db`.
DB_HOST=postgres
DB_PORT=5432
DB_NAME=portal
DB_USER=portal
DB_PASS=

# --- Очередь ------------------------------------------------------------------
# Общий Redis из слоя ClaudeDocker. Имя контейнера, а НЕ короткий алиас `redis`:
# на этом сервере алиас `redis` носят ДВА разных сервера — общий на сети
# shared-data и ClaudeService на claude-net. Контейнер, подключённый к обеим
# сетям (а api подключён), получает по короткому имени то один, то другой.
# Из-за этого api складывал задачи в чужую Redis, а воркер читал общую, и
# обработка молча не начиналась.
REDIS_URL=redis://shared-redis-1:6379
REDIS_PREFIX=portal:

# --- Криптография -------------------------------------------------------------
# JWT_SECRET подписывает токены сессий.
# TOKEN_ENCRYPTION_KEY шифрует токены доступа к площадкам в базе (32 байта в hex).
JWT_SECRET=
TOKEN_ENCRYPTION_KEY=

# --- Администратор ------------------------------------------------------------
# Кто получает роль admin при входе. Список пар «провайдер:идентификатор» через
# запятую, например: google:1234567890,tg_widget:987654321. Роль не выдаётся по
# факту регистрации: портал публичный, первым зарегистрироваться может кто угодно.
# Пересчитывается при каждом входе, так что правка действует со следующего.
ADMIN_IDENTITIES=

# --- Web Push (VAPID) ---------------------------------------------------------
# Генерируются один раз. Смена ключей обнуляет все существующие подписки.
VAPID_PUBLIC=
VAPID_PRIVATE=
VAPID_SUBJECT=mailto:admin@example.com

# --- Вход: OAuth --------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
VK_CLIENT_ID=
VK_CLIENT_SECRET=
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=

# --- Вход и уведомления: Telegram ---------------------------------------------
# Бот проекта — @solo_ai_journey_bot. Один и тот же токен обслуживает виджет
# входа на сайте, подпись мини-приложения и рассылку уведомлений.
TELEGRAM_BOT_TOKEN=
# Имя бота без @. Кнопка входа адресуется к боту по имени, а не по токену:
# токен секретный и в разметку попасть не может. Без имени кнопки входа через
# Telegram не будет, даже если токен задан.
TELEGRAM_BOT_USERNAME=
# Канал t.me/solo_ai_journey, где бот администратор. Туда с этапа 8 уходит
# анонс вышедшего урока.
TELEGRAM_CHANNEL_ID=

# --- Вход и уведомления: MAX --------------------------------------------------
MAX_BOT_TOKEN=

# --- Яндекс Диск: откуда портал берёт исходники -------------------------------
# Приложение в Яндекс OAuth с правом на Диск REST API. Доступ по OAuth, а не по
# публичной ссылке: публичная ссылка делает невышедший урок доступным всякому,
# кто её увидит, а токен — нет.
# Адрес возврата в кабинете приложения оставить как есть:
#   https://oauth.yandex.ru/verification_code
# Яндекс покажет код на экране, а автор скопирует его в кабинет портала.
# Свой адрес возврата в приложении заказчика указать нельзя, а для портала на
# одного человека это одно копирование раз в несколько месяцев.
YANDEX_OAUTH_CLIENT_ID=
YANDEX_OAUTH_CLIENT_SECRET=

# --- Тексты урока: заголовок, описание, теги ----------------------------------
# Ключ Gemini (aistudio.google.com/apikey). Нужен только кнопке «Заполнить из
# расшифровки»: без него она работает, но берёт заготовку из расшифровки своими
# силами — заголовок выходит первой фразой урока, а не его темой.
# На сторону уходит текст расшифровки, тот же, что через час будет на площадке.
GEMINI_API_KEY=
# Имя модели. Список доступных: GET https://generativelanguage.googleapis.com/
# v1beta/models с заголовком x-goog-api-key.
# Список моделей через запятую, в порядке предпочтения: берётся первая
# ответившая. Одна не годится — закреплённое имя однажды перестаёт выдаваться
# новым ключам, а на бесплатной доле ходовые модели разом отвечают «высокий
# спрос». Пустое значение означает список по умолчанию.
GEMINI_MODEL=
# Модели для рисования обложки, тоже списком. Рисование требует включённой
# оплаты на проекте Google Cloud: на бесплатной доле квота на них нулевая, а
# подписка в приложении Gemini на API не распространяется — проверено. Без
# оплаты кнопка честно скажет об отказе, а обложкой останется кадр из записи.
GEMINI_IMAGE_MODEL=

# --- Обработка: расшифровка ---------------------------------------------------
# Считается на самом сервере через whisper.cpp. Бинарник лежит в образе, модель
# качается один раз в том portal_models: 182 МБ в каждой сборке — это минуты на
# сборщике при каждом коммите. Пустые значения означают «как в образе».
WHISPER_BIN=
WHISPER_MODEL=
WHISPER_MODEL_URL=
# Модель отсечения тишины. Без неё распознавание залипает на длинных паузах и
# до конца записи печатает одну и ту же строку из чужих титров — проверено на
# настоящем уроке. Весит меньше мегабайта.
WHISPER_VAD_MODEL=
WHISPER_VAD_MODEL_URL=
# Язык записи. auto тоже работает, но на русском с ним модель иногда
# переключается на английский посреди урока.
WHISPER_LANGUAGE=ru
# Сколько ядер отдать счёту. Оба ядра машины; приоритет процесса понижен,
# иначе портал перестаёт открываться на всё время расшифровки.
WHISPER_THREADS=2

# Расшифровка считается на самом сервере (whisper.cpp), облачного поставщика в
# проекте нет — решение заказчика. Переменные ниже остались от отменённого
# варианта с Яндекс Облаком и не используются: пустыми они ничему не мешают,
# а заполненными включат путь, которого больше нет.
YANDEX_CLOUD_API_KEY=
YANDEX_CLOUD_FOLDER_ID=

# --- Публикация на площадки ---------------------------------------------------
# Долгоживущие токены доступа лежат в базе в зашифрованном виде,
# здесь только реквизиты приложений.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
VK_API_APP_ID=
VK_API_SECRET=
RUTUBE_CLIENT_ID=
RUTUBE_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# --- Тесты --------------------------------------------------------------------
# База для прогона тестов. В бою пустая: тесты в продакшене не запускаются,
# а непустое значение здесь означало бы, что боевые данные кто-то вычистит
# командой TRUNCATE из тестового помощника.
TEST_DATABASE_URL=

# --- Рабочий буфер ------------------------------------------------------------
# Каталог временных файлов и срок их жизни в часах.
# Постоянного видеоархива нет: по истечении срока файлы удаляются.
MEDIA_DIR=/app/media
MEDIA_TTL_HOURS=168
