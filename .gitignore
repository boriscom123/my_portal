# Секреты и локальная конфигурация — репозиторий публичный, сюда ничего не попадает
.env
.env.*
!.env.example
*.pem
*.key

# Исключение: корневой сертификат MAX. Это ПУБЛИЧНЫЙ сертификат центра, а не
# ключ, и без него портал не собирается из чистой копии — правило «*.pem» унесло
# его из репозитория, и сборка на GitHub падала на каждом файле, который
# добирается до кода площадок.
!certs/*.pem

# Рабочий буфер конвейера: исходники, нарезки, субтитры, обложки
media/
tmp/

# Служебные файлы блокировки, которые создаёт запись диалога
docs/history/*.lock

node_modules/
npm-debug.log*

.remember/

# Симлинки обратной связи ClaudeService: создаются автоматически при
# переключении проекта и указывают на абсолютный путь на VPS — в публичном
# репозитории они бесполезны (см. ClaudeService/scripts/projects.sh).
/scripts/tg-ask.sh
/scripts/tg-send.sh
